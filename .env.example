# Copy to .env and fill in. Both are required.

MONGO_URI=mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority

# OpenRouter serves both chat completions and embeddings, so one key covers the whole
# system. Any other OpenAI-compatible provider works if it serves /embeddings too —
# override LLM_BASE_URL. Models are pinned in config.py.
LLM_API_KEY=sk-or-v1-...
LLM_BASE_URL=https://openrouter.ai/api/v1
