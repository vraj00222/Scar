# Copy to .env and fill in.

# Required.
MONGO_URI=mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
OPENROUTER_API_KEY=sk-or-v1-...

# Strongly recommended. OpenRouter has no embeddings endpoint, so scar vectors come
# from OpenAI's text-embedding-3-small (1536 dims). Without this key, embed.py falls
# back to a lexical hash that is much worse at deduping paraphrased scars.
OPENAI_API_KEY=sk-...
