# Copy to .env and fill in. Both are required.

MONGO_URI=mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Any OpenAI-compatible chat-completions provider. Defaults to Novita; override
# LLM_BASE_URL to point elsewhere. Models are pinned in config.py.
LLM_API_KEY=sk_...
# LLM_BASE_URL=https://api.novita.ai/v3/openai
